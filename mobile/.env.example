# Copy to .env.local (see LEARNER_MOBILE_API_SPEC.md §1.1).
#
# Wi-Fi (phone and computer on the same network):
#   EXPO_PUBLIC_API_URL=http://<LAN_IP>:3001/api/v1
# USB with `adb reverse` (see mobile/README.md) — the phone reaches your computer via localhost:
#   EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
# Android emulator:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.50:3001/api/v1

# Optional: web app origin, used for relative media paths such as /sample.jpg.
# Defaults to the API host on port 3000.
# EXPO_PUBLIC_WEB_URL=http://192.168.1.50:3000
