PORT=3001

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=eltms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eltms?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=super-secret-access-key-change-me-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── MinIO ─────────────────────────────────────────────────
# MINIO_ROOT_* are read by docker-compose; MINIO_* by the app. Keep them equal.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eltms-files
MINIO_USE_SSL=false

# ── App ───────────────────────────────────────────────────
APP_NAME="MoR Tele ELTMS"
APP_ENV=development
# CORS origins, comma-separated: Next dev (3000) + Expo web (8081).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# ── LiveKit (docker-compose runs it with network_mode: host) ──
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Email (optional — without SMTP_HOST, emails are only logged) ──
# Emails go through a BullMQ queue on the Redis above; if Redis is down they are sent inline.
# Dev: MailHog from docker-compose: UI http://localhost:8025, SMTP port 1025, no TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ELTMS <noreply@eltms.local>"
# Production (Brevo): verify the sender (or its domain) in Brevo first; SMTP_FROM must use it.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false            # 587 = STARTTLS; use true only with port 465
# SMTP_USER=<brevo smtp login>
# SMTP_PASS=<brevo smtp key>
# SMTP_FROM="ELTMS <no-reply@your-verified-domain>"
# Public URL of the web app, used for links in emails (no trailing slash).
APP_PUBLIC_URL=http://localhost:3000
# Max emails per second the queue worker sends.
MAIL_RATE_LIMIT_PER_SEC=10
