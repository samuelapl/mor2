PORT=3000

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=eltms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eltms?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=super-secret-access-key-change-me-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── MinIO ─────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eltms-files
MINIO_USE_SSL=false

# ── App ───────────────────────────────────────────────────
APP_NAME="MoR Tele ELTMS"
APP_ENV=development
FRONTEND_URL=http://localhost:3001

# ── SMTP (optional — without these, password-reset emails are only logged) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MoR Tele ELTMS <no-reply@mor.gov.et>"
SMTP_SECURE=true
